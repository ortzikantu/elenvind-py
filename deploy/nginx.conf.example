# Elenvind 反向代理示例（Nginx）
#
# 复制到 /etc/nginx/conf.d/elenvind.conf 后按需改域名与证书路径，再
#   nginx -t && systemctl reload nginx
#
# 这份配置不是"可选优化"，而是生产必需：
#   * 应用只监听 127.0.0.1，TLS/HSTS 由这里终结；
#   * Gunicorn 用的是 sync worker（默认 2 个），**慢连接必须在这里掐掉**
#     —— 两个只声明 Content-Length 却不发正文的连接就足以让整站停摆
#     到 worker 超时（30s）。所以 client_*_timeout 与 limit_conn 是硬要求；
#   * 登录/注册在这里再做一层请求速率限制（应用内还有按邮箱/IP 的限流）。

# 以下两个 zone 必须写在 http { } 块里（本文件若被 include 进 http 块则直接可用）
limit_req_zone $binary_remote_addr zone=elenvind_auth:10m rate=20r/m;
limit_conn_zone $binary_remote_addr zone=elenvind_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # 不要泄漏上游/自身版本
    server_tokens off;

    # 与 config.toml 的 max_body_size 保持一致（略大一点，让应用返回 413 而不是 Nginx 413）
    client_max_body_size 1m;

    # 慢连接防线（关键）
    client_header_timeout 10s;
    client_body_timeout   10s;
    send_timeout          10s;
    keepalive_timeout     30s;

    # 访问日志：不记查询串可能带 token 的路径请自行裁剪
    access_log /var/log/nginx/elenvind.access.log;
    error_log  /var/log/nginx/elenvind.error.log warn;

    location / {
        limit_conn elenvind_conn 20;

        proxy_pass http://127.0.0.1:6789;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # 上游是 gunicorn，隐藏它的 Server 头
        proxy_hide_header Server;

        # 上游同步渲染，正常都在毫秒级；超过就说明卡住了
        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
        proxy_send_timeout    30s;

        # 不要缓冲大型上传（本站没有上传，保守设置即可）
        proxy_request_buffering on;
    }

    # 认证入口再做一层边缘限流（应用内还有邮箱/IP/全站三道闸门）
    location = /login {
        limit_req zone=elenvind_auth burst=5 nodelay;
        limit_conn elenvind_conn 10;
        proxy_pass http://127.0.0.1:6789;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Server;
    }

    location = /register {
        limit_req zone=elenvind_auth burst=3 nodelay;
        limit_conn elenvind_conn 10;
        proxy_pass http://127.0.0.1:6789;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Server;
    }

    # 健康检查：不新增应用端点，直接用静态的 robots.txt
    location = /healthz {
        access_log off;
        proxy_pass http://127.0.0.1:6789/robots.txt;
        proxy_set_header Host $host;
    }
}
